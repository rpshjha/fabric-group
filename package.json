{
  "name": "fabric-group",
  "version": "1.0.0",
  "description": "Playwright TypeScript E2E automation framework for ParaBank with UI, API and CI/CD integration.",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test:smoke": "playwright test --grep @smoke",
    "test": "playwright test",
    "test:e2e": "playwright test e2e-banking-journey.spec.ts",
    "test:api": "playwright test tests/api",
    "test:with-email-report": "SEND_EMAIL_REPORT=true playwright test",
    "test:report": "playwright show test-output/report",
    "security:secrets": "detect-secrets scan --baseline .secrets.baseline",
    "audit": "npm audit --audit-level=high",
    "precommit:check": "npm run lint && npm run format:check && npm run type-check",
    "quality:check": "npm run precommit:check && npm run security:secrets",
    "quality:full": "npm run quality:check && npm run test:smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rpshjha/fabric-group.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/rpshjha/fabric-group/issues"
  },
  "homepage": "https://github.com/rpshjha/fabric-group#readme",
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.58.2",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^6.4.23",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "detect-secrets": "^1.0.6",
    "dotenv": "^16.4.5",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^1.2.2",
    "eslint-plugin-security": "^4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemailer": "^8.0.4",
    "npm-audit-resolver": "^3.0.0-RC.0",
    "prettier": "^3.8.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  }
}
