# ParaBank Configuration
BASE_URL=https://parabank.parasoft.com
API_BASE_URL=https://parabank.parasoft.com/parabank

# Test Configuration
HEADLESS=true
SLOW_MO=0
TIMEOUT=60000
EXPECT_TIMEOUT=5000

# Browser Configuration
BROWSERS=chromium,firefox,webkit

VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# Faker locale - e.g. en, en_AU, en_US, ja, fr, de
FAKER_LOCALE=en_AU

# Email Configuration for Test Reports
SEND_EMAIL_REPORT=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=recipient@example.com
EMAIL_SUBJECT=Playwright Test Report
